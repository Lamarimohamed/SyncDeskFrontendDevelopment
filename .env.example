# SyncDesk Docker & Local Environment Configuration
# Copy to .env (`cp .env.example .env`) to customize ports or behavior.
# Do not store secrets in this file.

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Host port exposed for the frontend web application (http://localhost:8443)
FRONTEND_HOST_PORT=8443

# Build-time backend URL used by the browser client:
# - In Docker Compose, `/api` routes browser requests through the frontend
#   container's reverse proxy to `BACKEND_UPSTREAM_URL` (http://backend:8787).
# - For non-Docker local dev (`npm run dev`), set `VITE_BACKEND_URL=http://127.0.0.1:8787`.
VITE_BACKEND_URL=/api

# Expose demo authentication and sync simulation controls (`true` or `false`)
VITE_DEMO_MODE=true

# Internal Docker network upstream URL used by the frontend proxy container
BACKEND_UPSTREAM_URL=http://backend:8787

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
# Host port exposed for direct backend API access (http://localhost:8787)
BACKEND_HOST_PORT=8787

# Canonical replica identifier for the primary backend server
BACKEND_REPLICA_ID=backend-primary

# File path inside the backend container where the CRDT operation log and
# stock allocation snapshot are persisted (mounted on `syncdesk-backend-data`)
BACKEND_STORE_PATH=/var/lib/syncdesk/replica.json

# Allowed CORS origin (`*` or specific origin such as `http://localhost:8443`)
BACKEND_CORS_ORIGIN=*

# Maximum accepted JSON request body size in bytes
BACKEND_MAX_BODY_BYTES=262144

# -----------------------------------------------------------------------------
# Optional Distributed Experiment Runner Configuration (`--profile experiment`)
# -----------------------------------------------------------------------------
EXPERIMENT_SEED=20261103
GIT_COMMIT=unknown
